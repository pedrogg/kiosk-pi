# /etc/kiosk/board.env — copia este fichero, rellenalo y dejalo en 0600 root:kiosk.
# NO lo subas a ningun repo: BOARD_TOKEN es una credencial.

# URL de la pizarra, SIN el token.
BOARD_URL=https://pizarra.ejemplo.com/p/taller

# Token de LECTURA del tablero (kind=view). Nunca uno de escritura: esta Pi
# esta en una sala a la que entra gente, y lo unico que debe poder hacer quien
# se lleve la tarjeta SD es mirar lo que ya se ve en la pared.
BOARD_TOKEN=pon-aqui-el-token-de-lectura
