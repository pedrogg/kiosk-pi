[Unit]
Description=Pizarra en modo kiosko (Chromium bajo cage)
# La red tiene que estar arriba: sin ella Chromium arranca contra una URL
# muerta y la pagina entra en su estado "Sin conexion" desde el segundo cero.
After=network-online.target systemd-timesyncd.service
Wants=network-online.target
# Una pantalla que se reinicia en bucle rapido no se distingue de una apagada;
# este tope deja rastro en el journal en vez de esconderlo.
# OJO: StartLimit* van en [Unit]. Estaban en [Service], donde systemd los
# IGNORA ("Unknown key ... ignoring"), asi que el tope no existia: el 12-11-2026
# el servicio encadeno reinicios sin freno hasta que se arreglo cage.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=kiosk
# El token vive SOLO aqui (0600, root:kiosk). No en la unidad, que es legible
# por cualquiera, ni en la linea de comandos, que sale en `ps`.
EnvironmentFile=/etc/kiosk/board.env
# cage es un compositor Wayland y EXIGE XDG_RUNTIME_DIR: sin el aborta en
# cage.c:315 ("XDG_RUNTIME_DIR is not set in the environment") antes de abrir
# la pantalla, y systemd lo reinicia en bucle. Un servicio de SISTEMA no tiene
# sesion de logind, asi que /run/user/<uid> no existe nunca.
# RuntimeDirectory hace que systemd cree /run/kiosk (0700, del User= de esta
# unidad) al arrancar y lo borre al parar, sin depender de logind.
# Medido en una Pi 3B v1.2 el 12-11-2026: sin esto, 4 reinicios en 20 s y
# pantalla negra; con esto, active y 1 solo reinicio.
RuntimeDirectory=kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/kiosk
# Sin sesion de logind, wlroots necesita que no intente abrir dispositivos de
# entrada por su cuenta: en la pared no hay teclado ni raton.
Environment=WLR_LIBINPUT_NO_DEVICES=1
ExecStart=/usr/local/bin/kiosk-run.sh
Restart=always
RestartSec=5
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
